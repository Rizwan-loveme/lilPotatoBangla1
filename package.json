{
  "name": "lilpotato-captions",
  "version": "1.0.0",
  "private": true,
  "description": "Lil Potatoes video + English and animated colorful Bangla captions (React + Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render LilPotatoCaptions out/lilpotato1-captioned.mp4 --codec=h264 --crf=18",
    "separate": "bash scripts/separate-audio.sh src/lilpotato1.mp4",
    "srt": "node scripts/export-srt.mjs",
    "typecheck": "tsc --noEmit",
    "bundle": "remotion bundle"
  },
  "dependencies": {
    "@remotion/cli": "4.0.546",
    "@remotion/google-fonts": "4.0.546",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
